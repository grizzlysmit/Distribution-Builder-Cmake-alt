=end pod

my $home = $*HOME;


has %.meta;

method ls-l(IO::Handle:D $handle, Bool:D :$debug = False, *@args --> Bool:D) {
    my Proc $r;
    if shell 'which exa' {
        my @cmd = 'exa', '-F', '-laahigHb', '--color-scale', '--time-style=full-iso', '--icons=always';
        @cmd.push: @args if @args;
        $handle.say: qq[$?FILE\[$?LINE\] {@cmd.join(' ')}.] if $debug;
        $r = run |@cmd, :out($handle), :err($handle)        if $debug;
    } else {
        my @cmd = 'ls', '--color=auto', '-Flaghi', '--color';
        @cmd.push: @args if @args;
        $handle.say: qq[$?FILE\[$?LINE\] {@cmd.join(' ')}.] if $debug;
        $r = run |@cmd, :out($handle), :err($handle)        if $debug;
    }
}


method die-handle(IO::Handle:D $handle is copy, Str:D $msg --> Bool) {
    with %!meta«build»«log» {
        if %!meta«build»«log» ~~ rx/ ^^ '/dev/null' $$ / {
            $handle = "/dev/tty".IO.open: :append, :mode<rw>, :out-buffer(False);
        }
    }
    $handle.say: $msg;
    X::AdHoc.from-slurpy(10, False, $msg).throw;
}

method subst-man-number(Str:D $man-param, Str:D $man-number --> Str:D ) {
    my Str:D $result = $man-param;
    $result ~~ s:g/ '{' \h*'$man-number' \h* '}' /$man-number/;
    $result ~~ s:g/ '$man-number' <?wb> /$man-number/;
    return $result;
}

multi method resolve-dir(Any $dir, IO::Handle $handle, Bool $relitive-to-home = True --> False){
    self.die-handle($handle, "bad value");
}

multi method resolve-dir(Str:D $dir, IO::Handle $handle, Bool $relitive-to-home = True --> Str) is export {
    self.die-handle($handle, "bad value") without $dir;
    my Str $Dir = ~$dir;
    #$Dir.say;
    $Dir = $home if $Dir eq '~';
    $Dir = $home if $Dir ~~ rx/ ^^ '$*HOME' $$ /;
    $Dir = $home if $Dir ~~ rx/ ^^ '{' \s* '$*HOME' \s* '}' $$ /;
    $Dir = $home if $Dir ~~ rx/ ^^ '$HOME' $$ /;
    $Dir = $home if $Dir ~~ rx/ ^^ '{' \s* '$HOME' \s* '}' $$ /;
    $Dir ~~ s! ^^ '~' \/ !$home\/!;
    $Dir ~~ s! ^^ '$HOME' \/ !$home\/!;
    $Dir ~~ s! ^^ '{' \s* '$HOME' \s* '}' \/ !$home\/!;
    $Dir ~~ s! ^^ '$*HOME' \/ !$home\/!;
    $Dir ~~ s! ^^ '{' \s* '$*HOME' \s* '}' \/ !$home\/!;
    if $Dir ~~ rx! ^^ $<start> = [ '~' <-[ \/ ]> +  ] \/ ! {
        my Str $start = ~$<start>;
        given $start {
            when '~root' { $Dir ~~ s! ^^ '~' !\/!; }
            default {
                my Str @candidates = dir('/home', test => { "/home/$_".IO.d && $_ ne '.' && $_ ne '..' }).map: { $_.Str };
                my Str $start_d = $start.substr(1);
                my Str @cands = @candidates.grep: { rx/ \/ $start_d $$ / };
                if @cands == 1 {
                    my Str $candidate = @cands[0];
                    $Dir ~~ s! ^^ $start \/ !$candidate\/!;
                } else {
                    "cannot resolve $start".say;
                    return $dir;
                }
            }
        }
    }
    $Dir = "$home/$Dir" if $relitive-to-home && $Dir !~~ rx! ^^ \/ !;
    #$Dir.say;
    return $Dir;
} # multi method resolve-dir(Str:D $dir, Bool $relitive-to-home = True --> Str) is export #


sub Cmake-alt-resources(IO::Handle $handle, Bool:D $debug, *@resources --> Distribution::Resources) is export(:tests) {
    $handle.say: "$?FILE\[$?LINE\] Resource keys are: " ~ %?RESOURCES.keys.raku if $debug;
    for @resources -> $resource-filename {
        my $resource = %?RESOURCES{$resource-filename};
        # Just some error-checking code
        if $resource !~~ Distribution::Resource {
            $handle.say: "Could not find resource \`$resource-filename' in distribution";
            $handle.say: qx{ls -laF ; ls -laF resources ; cat META6.json};
            $handle.say: "Resource is: " ~ $resource.raku;
            $handle.say: "Resource keys are: " ~ %?RESOURCES.keys.raku;
        }
    }

    return %?RESOURCES;
}

method install-stuff(IO::Handle $handle, Str:D $name, Str:D $name-to, Str:D $from-path, Str:D $to-path-global,
                    Str:D $to-path-local, Str:D $thing, Bool:D $debug, %meta, Str :$pod-kind = Str,
                    Str:D :$base-library = $name, Bool:D :$remove-old = False, Bool:D :$grab-contents = False --> List) {
    my Proc $r;
    $handle.say: "$?FILE\[$?LINE\] pwd" if $debug; $r = run 'pwd', :out($handle), :err($handle) if $debug;
    my Str $install-location;
    $handle.say: "$?FILE\[$?LINE\] \$to-path-global == {$to-path-global.raku}" if $debug;
    my $tmp = self.resolve-dir($to-path-global, $handle);
    $handle.say: "$?FILE\[$?LINE\] \$to-path-global == {$tmp.raku}" if $debug;
    if $*USER == 0 || ($tmp.Bool && $tmp.IO ~~ :rwx) {
        $install-location = $tmp;
    } else {
        $handle.say: "$?FILE\[$?LINE\] \$to-path-global == {$to-path-global.raku}" if $debug;
        my $temp = self.resolve-dir($to-path-local, $handle);
        $handle.say: "$?FILE\[$?LINE\] \$to-path-global == {$temp.raku}" if $debug;
        self.die-handle($handle, "bad value for to-path-local") unless $temp.Bool;
        $install-location = $temp;
    }
    $handle.say: "$?FILE\[$?LINE\] \$to-path-local == {$to-path-local.raku}" if $debug;
    $handle.say: "$?FILE\[$?LINE\] \$install-location == {$install-location.raku}" if $debug;
    mkdir $install-location;
    # remove all old libs #
    if $remove-old {
        my $old-lib-pattern = "$install-location/$base-library";
        $handle.say: '$old-lib-pattern = ', $old-lib-pattern.raku if $debug;
        my @old-libs = $old-lib-pattern.IO.dirname.IO.dir( text => rx/ ^^ $old-lib-pattern [ \. \d+ [ \. \d+ [ \. \d+ ]? ]? ]? $$ /).map: { .Str };
        $handle.say: '@old-libs = ', @old-libs.raku if $debug;
        $handle.say: "$?FILE\[$?LINE\]" if $debug;
        $r = run 'pwd', :out($handle), :err($handle) if $debug;
        #«««
        for @old-libs -> $lib {
            #$handle.say: '$lib = ', $lib.raku if $debug;
            if $lib.IO ~~ :e && $lib.IO ~~ :d {
                $handle.say: "$?FILE\[$?LINE\] \$lib == {$lib}" if $debug;
                rmtree($lib.IO) if $lib.IO ~~ :e;
            } elsif $lib.IO ~~ :e  || $lib.IO ~~ :l {
                $handle.say: "$?FILE\[$?LINE\] \$lib == {$lib}" if $debug;
                $lib.IO.unlink();
            } else {
                $handle.say: "$?FILE\[$?LINE\] \$lib == {$lib}" if $debug;
            }
            CATCH {
                when X::IO::Unlink {
                    $handle.say: "$?FILE\[$?LINE\] \$lib == {$lib}" if $debug;
                    $handle.say: "$?FILE\[$?LINE\] { .^name}: {.Str}" if $debug;
                    exit -9;
                }
                default {
                    $handle.say: "$?FILE\[$?LINE\] \$lib == {$lib}" if $debug;
                    $handle.say: "$?FILE\[$?LINE\] { .^name}: {.Str}" if $debug;
                    exit -10;
                }
            }
        }
        #»»»
    }
    $handle.say: "$?FILE\[$?LINE\] pwd" if $debug; $r = run 'pwd', :out($handle), :err($handle) if $debug;
    my $from = "$from-path/$name";
    my $to   = "$install-location/$name-to";
    $handle.say: "$?FILE\[$?LINE\] pwd" if $debug; $r = run 'pwd', :out($handle), :err($handle) if $debug;
    $handle.say: '$from-path == ', $from-path.raku if $debug;
    $handle.say: '$install-location   == ', $install-location.raku if $debug;
    $handle.say: '$from == ', $from.raku if $debug;
    $handle.say: '$to   == ', $to.raku if $debug;
    if $grab-contents {
        $r = run 'exa', '-F', '-laahigHb', '--color-scale', '--time-style=full-iso', '--icons=always', $from-path, :out($handle), :err($handle) if $debug;
        $r = run 'exa', '-F', '-lahigHTb', '--color-scale', '--time-style=full-iso', '--icons=always', 'resources/', :out($handle), :err($handle) if $debug;
        $r = run 'exa', '-F', '-laahigHb', '--color-scale', '--time-style=full-iso', '--icons=always', $install-location, :out($handle), :err($handle) if $debug;
        $handle.say: "$?FILE\[$?LINE\] Resource keys are: " ~ %?RESOURCES.keys.raku if $debug;
        my $res = $from;
        $res ~~ s@ ^^ 'resources/' @@;
        my $resources = Cmake-alt-resources($handle, $debug, $res);
        $handle.say: "$?FILE\[$?LINE\] \$resources == {$resources.raku}" if $debug;
        $handle.say: "$?FILE\[$?LINE\] pwd" if $debug; $r = run 'pwd', :out($handle), :err($handle) if $debug;
        my $resource     = $resources{$res};
        $handle.say: qq[$?FILE\[$?LINE\] \$resource == \`{$resource.raku}'] if $debug;
        my IO::Handle:D $file_handle = $resource.open();
        #my IO::Handle:D $file_handle = %?RESOURCES{$res}.open();
        $handle.say: qq[$?FILE\[$?LINE\] \$resource == \`{$resource.raku}'] if $debug;
        my $contents  = slurp($file_handle, $handle, $debug);
        #my Str $contents = $resource.slurp;
        $handle.say: qq[$?FILE\[$?LINE\] \$contents == \`{$contents.raku}'] if $debug;
        $to.IO.spurt($contents);
        return True, $install-location;
        CATCH {
            when X::AdHoc {
                $handle.say: "$?FILE\[$?LINE\] \$from == {$from.raku}" if $debug;
                $handle.say: "$?FILE\[$?LINE\] \$to == {$to.raku}" if $debug;
                $handle.say: "$?FILE\[$?LINE\] \$res == {$res.raku}" if $debug;
                $handle.say: "Error: {DateTime.now.local.Str}  {.^name}   {.Str}";
                .throw;
            }
            default {
                $handle.say: "$?FILE\[$?LINE\] \$from == {$from.raku}" if $debug;
                $handle.say: "$?FILE\[$?LINE\] \$to == {$to.raku}" if $debug;
                $handle.say: "$?FILE\[$?LINE\] \$res == {$res.raku}" if $debug;
                $handle.say: "Error: {DateTime.now.local.Str}  {.^name}   {.Str}";
                .throw;
            }
        }
    } else {
        # to-path-global
        $from-path.IO.mkdir;
        with $from-path {
            with $pod-kind {
                with %meta«pod6-files» {
                    my @pod6-files = |(%meta«pod6-files»);
                    my IO::Handle $pod = $from.IO.open: :w, :out-buffer(False);
                    for @pod6-files -> $pod6-file {
                        $r = run 'raku', "--doc=$pod-kind", $pod6-file, :out($pod), :err($handle);
                    }
                    LEAVE {
                        $pod.close;
                    }
                }
            }
            if $from.IO ~~ :f {
                $handle.say: "$?FILE\[$?LINE\] pwd" if $debug; $r = run 'pwd', :out($handle), :err($handle) if $debug;
                $handle.say: "$?FILE\[$?LINE\]" if $debug;
                $handle.say: '$from = ', $from.raku if $debug;
                $handle.say: '$to = ', $to.raku if $debug;
                $r = run 'exa', '-F', '-laahigHb', '--color-scale', '--time-style=full-iso', '--icons=always', $from-path, :out($handle), :err($handle) if $debug;
                $r = run 'exa', '-F', '-lahigHTb', '--color-scale', '--time-style=full-iso', '--icons=always', 'resources/', :out($handle), :err($handle) if $debug;
                $r = run 'exa', '-F', '-laahigHb', '--color-scale', '--time-style=full-iso', '--icons=always', $install-location, :out($handle), :err($handle) if $debug;
                $handle.say: "$?FILE\[$?LINE\]" if $debug;
                $r = run 'exa', '-F', '-laahigHb', '--color-scale', '--time-style=full-iso', '--icons=always', $from, :out($handle), :err($handle) if $debug;
                $r = run 'exa', '-F', '-laahigHb', '--color-scale', '--time-style=full-iso', '--icons=always', $to.IO.dirname, :out($handle), :err($handle) if $debug;
                #$to.IO.unlink() if $to.IO ~~ :e;
                $handle.say: "$?FILE\[$?LINE\]" if $debug;
                $install-location.IO.mkdir;
                $handle.say: '$from = ', $from.raku if $debug;
                $handle.say: '$to = ', $to.raku if $debug;
                $handle.say: "$?FILE\[$?LINE\]" if $debug;
                self.die-handle($handle, "Error: Failed to install $thing: $name") unless $from.IO.copy($to.IO);
                $handle.say: "$?FILE\[$?LINE\] \$thing == {$thing}" if $debug;
            } elsif $from.IO ~~ :e {
                given $from.IO {
                    when :d { self.die-handle($handle, "Error: \`$from' is a directory should be a regular file"); }
                    default { self.die-handle($handle, "Error: $from is not a regular file"); }
                }
            } else {
                return False, $install-location;
            }
            $handle.say: "$?FILE\[$?LINE\] \$thing == {$thing}" if $debug;
            return True, $install-location;
        } else {
            return False, $install-location;
        }
    }
} #`««« method install-stuff(IO::Handle $handle, Str:D $name, Str:D $name-to, Str:D $from-path, Str:D $to-path-global,
                    Str:D $to-path-local, Str:D $thing, Bool:D $debug, %meta, Str :$pod-kind = Str,
                    Str:D :$base-library = $name, Bool:D :$remove-old = False, Bool:D :$grab-contents = False --> List) »»»




method build(IO() $work-dir = $*CWD) {
    my Bool:D $debug = False;
    with %!meta«build»«debug» {
        $debug = %!meta«build»«debug».Bool;
    }
    my IO::Path:D $log = "/dev/null".IO;
    with %!meta«build»«log» {
        my Str:D $tmp = %!meta«build»«log»;
        if $tmp eq '/dev/tty' {
            $log = $tmp.IO;
        } else {
            my IO::Handle:D $handle-tmp = "/dev/tty".IO.open: :append, :mode<rw>, :out-buffer(False);
            $log = self.resolve-dir($tmp, $handle-tmp).IO;
        }
    }
    $log.dirname.IO.mkdir if $debug && $log.path !~~ rx@ ^^ '/dev/' .* $$ @;
    #my $log = "/dev/tty".IO;
    #my IO::Handle:D $handle = $log.open: :append, :create, :mode<rw>;
    my Bool:D $create = $log !~~ rx@ ^^ '/dev/' .* $$ @;
    my IO::Handle:D $handle = $log.open: :append, :$create, :mode<rw>, :out-buffer(False);
    $*OUT = $handle;
    $*ERR = $handle;
    
    my Proc $r;
    $handle.say: '%!meta = ', %!meta.raku if $debug;
    my %meta = %!meta<build>;
    $handle.say: '%meta = ', %meta.raku if $debug;
    self.die-handle($handle, 'You need CMake to install this package!') unless shell 'which cmake';
    self.die-handle($handle, 'You need Make to install this package!') unless shell 'which make';
    self.die-handle($handle, qq[field "lib" must be supplied inside field "build"]) without %meta«lib»;

    $handle.say: "$?FILE\[$?LINE\] pwd" if $debug; $r = run 'pwd', :out($handle), :err($handle) if $debug;
    self.ls-l: $handle, :$debug;
    $handle.say: "$?FILE\[$?LINE\] pwd" if $debug; $r = run 'pwd', :out($handle), :err($handle) if $debug;
    self.ls-l: $handle, :$debug, 'doc/';
    self.ls-l: $handle, :$debug, 'doc/Distribution/Builder/';
    $handle.say: "$?FILE\[$?LINE\] pwd" if $debug; $r = run 'pwd', :out($handle), :err($handle) if $debug;

    # Prepare to build
    my $src-dir;
    my $cmake-src-dir;
    with %meta«src-dir» {
        $src-dir = %meta«src-dir»;
        if $src-dir eq '.' || $src-dir eq '' {
            $cmake-src-dir = '';
        } else {
            $cmake-src-dir = "$src-dir";
        }
    } else {
        $src-dir       = '';
        $cmake-src-dir = "";
    }
    $handle.say: '$cmake-src-dir = ', $cmake-src-dir.raku if $debug;
    if $cmake-src-dir eq '.' || $cmake-src-dir eq '' {
        self.ls-l: $handle, :$debug;
    } else {
        self.ls-l: $handle, :$debug, $cmake-src-dir;
    }
    #self.die-handle($handle, "$cmake-src-dir is not a directory.") unless $cmake-src-dir eq '' || $cmake-src-dir eq '.' || ($cmake-src-dir.IO.e && $cmake-src-dir.IO.d);

    # Build
    my $build-dir;
    if $cmake-src-dir eq '' || $cmake-src-dir eq '.' {
        $build-dir = 'build';
    }else {
        $build-dir = "$cmake-src-dir/build";
        chdir($cmake-src-dir.IO);
    }
    my Str:D $source = '';
    with %meta«source» {
        $source = %meta«source» // '';
    }
    # start with a clean empty build directory #
    if "build".IO ~~ :d {
        rmtree("build".IO);
    } else {
        "build".IO.unlink();
    }
    "build".IO.mkdir;
    $r = run 'pwd', :out($handle), :err($handle) if $debug;
    $handle.say: '$build-dir = ', $build-dir.raku if $debug;
    chdir("build".IO);
    $r = run 'pwd', :out($handle), :err($handle) if $debug;
    self.ls-l: $handle, :$debug, '..';
    $handle.say: "cmake .." if $debug;
    self.ls-l: $handle, :$debug, '.';
    $handle.say: "make" if $debug;
    $r = run 'make', :out($handle), :err($handle);
    self.ls-l: $handle, :$debug, '.';
    $handle.say: "$?FILE\[$?LINE\] pwd" if $debug; $r = run 'pwd', :out($handle), :err($handle) if $debug;
    if $build-dir eq 'build' || $build-dir eq './build' {
        chdir('..');
        $r = run 'pwd', :out($handle), :err($handle) if $debug;
    } else {
        my $tmp = $build-dir;
        while !($tmp eq '' || $tmp eq '/' || $tmp eq '.') {
            $handle.say: '$tmp = ', $tmp.raku if $debug;
            chdir('..');
            $r = run 'pwd', :out($handle), :err($handle) if $debug;
            $tmp = $tmp.IO.dirname;
        }
        $handle.say: '$tmp = ', $tmp.raku if $debug;
    }
    $handle.say: "$?FILE\[$?LINE\] pwd" if $debug; $r = run 'pwd', :out($handle), :err($handle) if $debug;

    # Prepare library target
    my $library = "lib{ %meta<lib> }.so"; # If your cmake is setup properly, then it should start with 'lib'
    my $base-library = $library;
    $handle.say: '$library = ', $library.raku if $debug;
    my %libraries;
    my %lib-versions;
    with %meta«lib-versions» {
        %lib-versions = %meta«lib-versions»;
        $handle.say: '%lib-versions = ', %lib-versions.raku if $debug;
        for %lib-versions.kv -> $ver, $to {
            if $ver eq '' {
                %libraries{$library.Str} = "{$library}.$to";
            } else {
                %libraries{"{$library}.$ver"} = "{$library}.$to";
            }
        } # for %lib-versions.kv -> $ver, $to #
        $handle.say: '%libraries = ', %libraries.raku if $debug;
    } # with %meta«lib-versions» #
    # Prepare install location
    $handle.say: "$?FILE\[$?LINE\] pwd" if $debug; $r = run 'pwd', :out($handle), :err($handle) if $debug;
    my Str:D $install = "/use/local/lib";
    with %meta«install» {
        $install = %meta«install»;
    }
    my Str:D $install-local = "$home/lib";
    with %meta«install-local» {
        $install-local = %meta«install-local»;
    }
    $r = run 'pwd', :out($handle), :err($handle) if $debug;
    $handle.say: "$?FILE\[$?LINE\]" if $debug;
    with %meta«master-lib-version» {
        my $ver   = %meta«master-lib-version»;
        $library ~= ".$ver";
    }
    $handle.say: "$?FILE\[$?LINE\] pwd" if $debug; $r = run 'pwd', :out($handle), :err($handle) if $debug;
    $handle.say: "$?FILE\[$?LINE\] \$library == {$library}" if $debug;
    self.ls-l: $handle, :$debug, '.';


    # Install
    my ($ok, $install-location) = self.install-stuff($handle, $library, $library, $build-dir, $install, $install-local, 'library', $debug, %meta, :$base-library, :remove-old);
    $handle.say: "$?FILE\[$?LINE\] \$install-location == {$install-location.raku}" if $debug;
    # man page generation #
    my Str:D $man-number = '1';
    with %meta«man-number» {
        $man-number = %meta«man-number»;
    }
    $handle.say: "$?FILE\[$?LINE\] \$man-number == {$man-number.raku}" if $debug;
    my $man;
    with %meta«man» {
        $handle.say: "$?FILE\[$?LINE\] \$man-number == {$man-number.raku}\n\$man == {$man.raku}" if $debug;
        $man = self.subst-man-number(%meta«man», $man-number);
        $handle.say: "$?FILE\[$?LINE\] \$man-number == {$man-number.raku}\n\$man == {$man.raku}" if $debug;
    }
    my Str:D $man-name = '';
    with $man {
        $man-name = $man.IO.basename;
    }
    my Str:D $man-install = "/usr/local/man/man{$man-number}";
    my Str:D $man-name-to = "$man-install/$man-name";
    with %meta«man-install» {
        $man-install = self.subst-man-number(%meta«man-install», $man-number);
        $handle.say: "$?FILE\[$?LINE\] \$man-number == {$man-number.raku}\n\$man-install == {$man-install.raku}" if $debug;
        $man-name-to = $man-install.IO.basename;
        $handle.say: "$?FILE\[$?LINE\] \$man-number == {$man-number.raku}\n\$man-install == {$man-install.raku}" if $debug;
        $man-install = $man-install.IO.dirname;
        $handle.say: "$?FILE\[$?LINE\] \$man-number == {$man-number.raku}\n\$man-install == {$man-install.raku}" if $debug;
    }
    my $man-install-local = '$HOME/man/man$man-number';
    with %meta«man-install-local» {
        $man-install-local = self.subst-man-number(%meta«man-install-local», $man-number);
        self.die-handle($handle, "Error: global and local man page name must match") unless $man-name-to eq $man-install-local.IO.basename;
        $man-install-local = $man-install-local.IO.dirname;
    }
    $handle.say: "$?FILE\[$?LINE\] \$man-name-to == {$man-name-to.raku}" if $debug;
    self.install-stuff($handle, $man-name, $man-name-to, $man.IO.dirname, $man-install, $man-install-local, 'man page', $debug, %meta, :pod-kind('Man'));
    $handle.say: "$?FILE\[$?LINE\] \$man-name-to == {$man-name-to.raku}" if $debug;
    $handle.say: "$?FILE\[$?LINE\] pwd" if $debug; $r = run 'pwd', :out($handle), :err($handle) if $debug;
    # html page install #
    my Str $html;
    with %meta«html» {
        $html = %meta«html»;
    }
    my Str:D $html-name = '';
    with $html {
        $html-name = $html.IO.basename;
    }
    my Str:D $html-install = "/usr/local/html/$html-name";
    my Str:D $html-name-to = $html-name;
    with %meta«html-install» {
        $html-install = %meta«html-install»;
        $html-name-to = $html-install.IO.basename;
        $html-install = $html-install.IO.dirname;
    }
    my Str:D $html-install-local = "$home/html";
    with %meta«html-install-local» {
        $html-install-local = %meta«html-install-local»;
        self.die-handle($handle, "Error: global and local html page name must match") unless $html-name-to eq $html-install-local.IO.basename;
        $html-install-local = $html-install-local.IO.dirname;
    }
    self.install-stuff($handle, $html-name, $html-name-to, $html.IO.dirname, $html-install, $html-install-local, 'html page', $debug, %meta, :pod-kind('HTML'));
    $handle.say: "$?FILE\[$?LINE\] \$install-location == {$install-location}" if $debug;
    $handle.say: "$?FILE\[$?LINE\] pwd" if $debug; $r = run 'pwd', :out($handle), :err($handle) if $debug;
    # markdown page intall #
    my Str $markdown-path;
    with %meta«markdown-path» {
        $markdown-path = %meta«markdown-path»;
    }
    my Str:D $markdown-path-name = '';
    with $markdown-path {
        $markdown-path-name = $markdown-path.IO.basename;
    }
    my Str:D $markdown-path-install = "/usr/local/markdown-path/$markdown-path-name";
    my Str:D $markdown-path-name-to = $markdown-path-name;
    with %meta«markdown-path-install» {
        $markdown-path-install = %meta«markdown-path-install»;
        $markdown-path-name-to = $markdown-path-install.IO.basename;
        $markdown-path-install = $markdown-path-install.IO.dirname;
    }
    my Str:D $markdown-path-install-local = "$home/markdown-path/{$markdown-path-name}";
    with %meta«markdown-path-install-local» {
        $markdown-path-install-local = %meta«markdown-path-install-local»;
        self.die-handle($handle, "Error: global and local markdown-path page name must match") unless $markdown-path-name-to eq $markdown-path-install-local.IO.basename;
        $markdown-path-install-local = $markdown-path-install-local.IO.dirname;
    }
    $handle.say: "$?FILE\[$?LINE\] \$markdown-path-name == {$markdown-path-name}" if $debug;
    $handle.say: "$?FILE\[$?LINE\] \$markdown-path-install == {$markdown-path-install}\n$markdown-path-install-local == {$markdown-path-install-local}" if $debug;
    self.install-stuff($handle, $markdown-path-name, $markdown-path-name-to, $markdown-path.IO.dirname,
                                                            $markdown-path-install, $markdown-path-install-local, 'markdown-path page', $debug, %meta, :pod-kind('Markdown'));
    $handle.say: "$?FILE\[$?LINE\] \$install-location == {$install-location}" if $debug;
    $handle.say: "$?FILE\[$?LINE\] pwd" if $debug; $r = run 'pwd', :out($handle), :err($handle) if $debug;

    # install library symbolic links #
    chdir("$install-location".IO);
    $handle.say: "$?FILE\[$?LINE\] pwd" if $debug; $r = run 'pwd', :out($handle), :err($handle) if $debug;
    self.ls-l: $handle, :$debug, $install-location;
    if %libraries {
        my @libs = %libraries.pairs.sort( { $^a.value leg $^b.value } ).reverse;
        $handle.say: '@libs = ', @libs.raku if $debug;
        for @libs -> $pair {
            my $link   = $pair.key;
            my $target = $pair.value;
            "$link".IO.unlink if "$link".IO ~~ :e;
            "$target".IO.symlink("$link".IO, :!absolute);
        }
    }
    $handle.say: "$?FILE\[$?LINE\] pwd" if $debug; $r = run 'pwd', :out($handle), :err($handle) if $debug;
    self.ls-l: $handle, :$debug;
    True;
} # method build(IO() $work-dir = $*CWD)  #
