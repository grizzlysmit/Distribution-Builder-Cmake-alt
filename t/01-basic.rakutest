use Test;
use Distribution::Builder::Cmake-alt;

plan 7;

my %build =
            lib => 'test',
            src-dir => 't/cc',
            install => '/usr/local/lib', # need it not to polute the global system this is a test #
            install-local => '$*HOME/lib',
            "master-lib-version"=> "1.0.0",
            "lib-versions" => {
                "1" => "1.0.0",
                "" => "1"
            },
            "pod6-files" => [
                "lib/Gzz/Readline.rakumod"
            ],
            "man-number" => "3",
            "man"    => 'resources/doc/Distribution/Builder/Cmake-alt.$man-number',
            "man-install" => '/usr/local/man/man$man-number/Distribution::Builder::Cmake-alt.$man-number',
            "man-install-local" => '$*HOME/man/man$man-number/Distribution::Builder::Cmake-alt.$man-number',
            "html" => "resources/doc/Distribution/Builder/Cmake-alt.html",
            "html-install" => "/usr/local/share/html/Distribution::Builder::Cmake-alt.html",
            "html-install-local" => '$HOME/html/Distribution::Builder::Cmake-alt.html',
            "markdown-path" => "resources/doc/README.md",
            "markdown-path-install" => "/usr/local/share/Distribution::Builder::Cmake-alt/README.md",
            "markdown-path-install-local" => '$HOME/docs/Distribution::Builder::Cmake-alt/README.md',
            "source" => "",
            "debug"  => False,
            "log"    => "/dev/null";

my %meta = Map.new: (:%build);

my $builder = Distribution::Builder::Cmake-alt.new(:%meta);

my Str:D $HOME = $*HOME.path;
my Str:D $man-number = '3';

lives-ok({ $builder.build("$*CWD/t")}, "build process" );
ok({ 't/resources/libraries/libtest.so.1.0.0'.IO.e }, "does libtest.so.1.0.0 exist?");
ok({ 't/resources/libraries/libtest.so.1'.IO.e }, "does libtest.so.1 exist?");
ok({ 't/resources/libraries/libtest.so'.IO.e }, "does libtest.so exist?");
ok({ "$*HOME/man/man$man-number/Distribution::Builder::Cmake-alt.$man-number".IO.e }, "does \`$*HOME/man/man$man-number/Distribution::Builder::Cmake-alt.$man-number' exist?");
ok({ "$*HOME/html/Distribution::Builder::Cmake-alt.html".IO.e }, "does \`$*HOME/html/Distribution::Builder::Cmake-alt.html' exist?");
ok({ "$HOME/docs/Distribution::Builder::Cmake-alt/README.md".IO.e }, "does \`$HOME/docs/Distribution::Builder::Cmake-alt/README.md' exist?");

done-testing;
