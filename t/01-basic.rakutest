use Test;
use Distribution::Builder::Cmake-alt;

plan 4;

my %build =
            lib => 'test',
            src-dir => 't/cc',
            install => 'usr/local/lib', # need it not to polute the global system this is a test #
            install-local => '$*HOME/lib',
            "master-lib-version"=> "1.0.0",
            "lib-versions" => {
                "1" => "1.0.0",
                "" => "1"
            },
            "man"    => "resources/doc/Distribution/Builder/Cmake-alt.1",
            "man-install" => "/usr/local/man/man1/Distribution::Builder::Cmake-alt.1",
            "man-install-local" => '$*HOME/man/man1/Distribution::Builder::Cmake-alt.1',
            "html" => "resources/doc/Distribution/Builder/Cmake-alt.html",
            "html-install" => "/usr/local/share/html/Distribution::Builder::Cmake-alt.html",
            "html-install-local" => '$HOME/html/Distribution::Builder::Cmake-alt.html',
            "source" => "",
            "debug"  => True,
            "log"    => "/dev/tty";

my %meta = Map.new: (:%build);

my $builder = Distribution::Builder::Cmake-alt.new(:%meta);

lives-ok({ $builder.build("$*CWD/t")}, "build process" );
ok({ 't/resources/libraries/libtest.so.1.0.0'.IO.e }, "does libtest.so.1.0.0 exist?");
ok({ 't/resources/libraries/libtest.so.1'.IO.e }, "does libtest.so.1 exist?");
ok({ 't/resources/libraries/libtest.so'.IO.e }, "does libtest.so exist?");

done-testing;
